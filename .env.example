# Copiez ce fichier en .env.local (jamais commité), puis renseignez les valeurs de votre projet
# Supabase : Project Settings → API Keys (et Data API pour l'URL).

# URL du projet, par exemple https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (« publishable », commence par sb_publishable_). Les anciens projets peuvent utiliser
# la clé « anon » dans NEXT_PUBLIC_SUPABASE_ANON_KEY à la place.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique de l'application, utilisée dans les liens envoyés par e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Proposer l'agence de démonstration (données fictives) à l'inscription : true en développement,
# false en production tant que la démonstration n'est pas souhaitée.
DEMO_DATA_ENABLED=true

# La clé secrète (sb_secret_…) n'est PAS nécessaire : l'application n'agit qu'au nom de la personne
# connectée, sous la RLS. Ne la placez jamais dans une variable NEXT_PUBLIC_.

# E-mails transactionnels (Brevo). La clé est secrète : uniquement dans .env.local et dans Vercel,
# jamais dans une variable NEXT_PUBLIC_. Droits conseillés : « E-mails transactionnels » seulement.
BREVO_API_KEY=
# Expéditeur authentifié dans Brevo (domaine myselectagency.com).
BREVO_SENDER_EMAIL=notifications@myselectagency.com
# true = mode bac à sable : Brevo vérifie tout mais n'envoie rien (tests).
BREVO_SANDBOX=
# Secret de la tâche planifiée quotidienne (/api/cron/emails, voir vercel.json) : 32 caractères ou plus,
# jamais dans une variable NEXT_PUBLIC_. Vercel l'envoie dans l'en-tête Authorization. Son empreinte SHA-256
# doit être enregistrée dans la base (private.system_secrets, clé « email_worker »).
CRON_SECRET=
# Jeton du webhook Brevo (suivi de livraison, /api/webhooks/brevo) : 32 caractères ou plus. Il se colle dans
# Brevo (Intégrations > Webhooks, authentification par jeton) ; l'application ne le lit pas. Seule son
# empreinte SHA-256 est enregistrée dans la base (private.system_secrets, clé « brevo_webhook »).
BREVO_WEBHOOK_SECRET=
