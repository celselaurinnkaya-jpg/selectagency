# Copiez ce fichier en .env.local (jamais commité), puis renseignez les valeurs de votre projet
# Supabase : Project Settings → API Keys (et Data API pour l'URL).

# URL du projet, par exemple https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (« publishable », commence par sb_publishable_). Les anciens projets peuvent utiliser
# la clé « anon » dans NEXT_PUBLIC_SUPABASE_ANON_KEY à la place.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique de l'application, utilisée dans les liens envoyés par e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Proposer l'agence de démonstration (données fictives) à l'inscription : true en développement,
# false en production tant que la démonstration n'est pas souhaitée.
DEMO_DATA_ENABLED=true

# La clé secrète (sb_secret_…) n'est PAS nécessaire : l'application n'agit qu'au nom de la personne
# connectée, sous la RLS. Ne la placez jamais dans une variable NEXT_PUBLIC_.
